<scc:ThemedUserControl x:Class="Supremacy.Client.Views.ColonyBuildProjectInfoView"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:s="http://schemas.startreksupremacy.com/xaml/core"
                       xmlns:scc="http://schemas.startreksupremacy.com/xaml/presentation"
                       Background="Black"
                       TextElement.FontSize="{DynamicResource {x:Static scc:ClientResources.InfoPaneFontSizeKey}}"
                       TextElement.FontFamily="{DynamicResource {x:Static scc:ClientResources.InfoPaneFontFamilyKey}}"
                       TextElement.FontWeight="{DynamicResource {x:Static scc:ClientResources.InfoPaneFontWeightKey}}">
    
  <TabControl x:Name="RootTabControl">
        <TabItem Header="{Binding Source=TECH_OBJECT_STATISTICS, Converter={StaticResource StringResourceConverter}, ConverterParameter=UpperCase}"
             Background="Black" IsSelected="True">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Width="235">
                <DockPanel LastChildFill="True" 
                   Margin="0,0,0,7">
                    
                    <!--2026-04-25-->
                    <TextBlock DockPanel.Dock="Top"
                     Foreground="{StaticResource {x:Static scc:ClientResources.HeaderTextForegroundBrushKey}}"
                     FontFamily="{StaticResource {x:Static scc:ClientResources.DefaultFontFamilyKey}}"
                     Background="Black"
                     FontSize="14pt"
                     Margin="0,0,0,14"
                     TextWrapping="Wrap"
                     Text="{Binding Path=BuildDesign.Name, Converter={StaticResource StringResourceConverter}}" />

                    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource {x:Static scc:ClientResources.DefaultTextForegroundBrushKey}}"
                     FontFamily="{StaticResource {x:Static scc:ClientResources.DefaultFontFamilyKey}}"
                     Background="Black"
                     FontSize="14pt"
                     Margin="0,7,0,0"
                     TextWrapping="Wrap"
                     Text="{Binding Path=BuildDesign.Description, Mode=OneWay, Converter={StaticResource StringResourceConverter}}" />
                    
                    <ContentControl DockPanel.Dock="Top" FontSize="12pt" Background="Black"
                          Style="{DynamicResource TechObjectInfoPanelStyle}">
                        <ContentControl.Content>
                            <!-- by clicking an entry to the planetary build option list
                            System.Windows.Data Error: 2 : Cannot find governing FrameworkElement or FrameworkContentElement for target element. BindingExpression:Path=(0); DataItem='ProductionFacilityBuildProject' (HashCode=2348991); target element is 'TechObjectDesignViewModel' (HashCode=36893205); target property is 'Design' (type 'TechObjectDesign')
                            System.Windows.Data Error: 2 : Cannot find governing FrameworkElement or FrameworkContentElement for target element. BindingExpression:Path=(0); DataItem='ProductionFacilityBuildProject' (HashCode=2348991); target element is 'TechObjectDesignViewModel' (HashCode=36893205); target property is 'Location' (type 'Nullable`1')
                            System.Windows.Data Error: 2 : Cannot find governing FrameworkElement or FrameworkContentElement for target element. BindingExpression:Path=(0); DataItem='ProductionFacilityBuildProject' (HashCode=2348991); target element is 'TechObjectDesignViewModel' (HashCode=36893205); target property is 'Civilization' (type 'Civilization')-->
                            <scc:TechObjectDesignViewModel Design="{Binding Path=(s:BuildProject.BuildDesign), Mode=OneWay, Converter={StaticResource StringResourceConverter}}"
                                             Location="{Binding Path=(s:BuildProject.Location), Mode=OneWay, Converter={StaticResource StringResourceConverter}}"
                                             Civilization="{Binding Path=(s:BuildProject.Builder), Mode=OneWay, Converter={StaticResource StringResourceConverter}}" />
                            
                        </ContentControl.Content>
                    </ContentControl>

                </DockPanel>
            </ScrollViewer>
        </TabItem>
      
